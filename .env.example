# Required: public DNS hostname only, no https:// or trailing slash.
XGIFT_DOMAIN=gift.example.com
# Required: your email for certificate expiry/account notifications.
ACME_EMAIL=you@example.com
# Enable only after completing setup and checking the catalog and credentials.
XGIFT_PAYMENTS_ENABLED=false
TZ=Asia/Shanghai
# Keep this unchanged after deployment: it determines persistent volume names.
COMPOSE_PROJECT_NAME=xgift
XGIFT_IMAGE=ghcr.io/sensiribbed/x_gift_bot:latest
CADDY_IMAGE=caddy:2-alpine
# Must satisfy the version in upstream go.mod when upgrading.
GO_IMAGE=golang:1.27.1-bookworm
NODE_IMAGE=node:22-bookworm-slim
